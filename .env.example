# All optional. Save as .env next to package.json. Or just pick an AI in the dashboard's AI menu.

# Claude via the API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Local models: found automatically at their default addresses
# OLLAMA_URL=http://127.0.0.1:11434
# LMSTUDIO_URL=http://127.0.0.1:1234

# Any OpenAI-compatible service (OpenRouter, OpenAI, Groq, Gemini, llama.cpp, vLLM...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=

# Jev by TypeSafe (https://console.typesafe.ai/keys): instant quick commands. Or paste the key in the AI menu.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Starting AI; picking one in the dashboard overrides this
# SCRUFF_PROVIDER=claude        # claude | ollama | lmstudio | openai
# SCRUFF_MODEL=claude-opus-5
# SCRUFF_EFFORT=medium          # Claude only: low | medium | high | xhigh | max
# SCRUFF_PORT=7777

# Overlay hotkeys (https://www.electronjs.org/docs/latest/api/accelerator)
# SCRUFF_HOTKEY_PANEL=CommandOrControl+Shift+S
# SCRUFF_HOTKEY_TALK=CommandOrControl+Shift+Space
