{
  "name": "scruff",
  "version": "0.1.0",
  "description": "An in-game overlay you talk to (Claude, your Claude subscription, or a local model) that live-mods single-player games.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron overlay/main.mjs",
    "hub": "tsx src/index.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "demo-game": "node examples/demo-game/game.mjs",
    "typecheck": "tsc --noEmit",
    "build:bridge": "sh bridge/build.sh",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "electron": "^44.4.5",
    "koffi": "^3.3.2",
    "openai": "^7.23.0",
    "thinking-orbs": "^0.3.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
